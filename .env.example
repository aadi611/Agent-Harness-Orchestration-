# ==========================================
# RAG Agent Harness - Environment Configuration
# ==========================================

# Application
APP_NAME=rag-agent-harness
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ==========================================
# LLM Provider
# ==========================================

LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TEMPERATURE=0.0
OPENAI_MAX_TOKENS=2048

# Embedding model
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536

# ==========================================
# Agent Orchestration
# ==========================================

AGENT_FRAMEWORK=langgraph
AGENT_MAX_ITERATIONS=10
AGENT_RECURSION_LIMIT=25
AGENT_TIMEOUT_SECONDS=120
AGENT_VERBOSE=true

# Enable or disable agent capabilities
ENABLE_TOOL_CALLING=true
ENABLE_RETRIEVAL=true
ENABLE_QUERY_REWRITE=true
ENABLE_RERANKING=false
ENABLE_HALLUCINATION_CHECK=true

# ==========================================
# Retrieval Configuration
# ==========================================

RETRIEVER_TOP_K=5
RETRIEVER_SCORE_THRESHOLD=0.0
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ==========================================
# Vector Database
# ==========================================

VECTOR_STORE_PROVIDER=chroma
CHROMA_PERSIST_DIRECTORY=./data/chroma
CHROMA_COLLECTION_NAME=rag_documents

# Optional: PostgreSQL with pgvector
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/ragdb

# Optional: Pinecone
# PINECONE_API_KEY=your_pinecone_api_key
# PINECONE_INDEX_NAME=your_index_name

# ==========================================
# LangSmith Tracing / Observability
# ==========================================

LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=rag-agent-harness

# ==========================================
# API Configuration (optional)
# ==========================================

API_HOST=127.0.0.1
API_PORT=8000

# ==========================================
# Security
# ==========================================

# Generate a unique secret if your application requires one.
APP_SECRET_KEY=replace_with_a_random_secret
